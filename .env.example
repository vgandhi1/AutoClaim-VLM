# ── Copy to .env and fill in values. Never commit .env ──

# ── Application ──
ENVIRONMENT=development

# ── AWS (local dev / CLI — use IAM roles in deployed Lambdas/Glue) ──
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── S3 buckets (legacy CLAIMLENS_* prefix — bucket names, not secrets) ──
CLAIMLENS_RAW_BUCKET=vehicle-damage-opensource-raw
CLAIMLENS_PROCESSED_BUCKET=vehicle-damage-opensource-processed

# ── SageMaker / VLM ──
MODEL_ID=google/paligemma-3b-pt-448
# SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole

# ── Dataset ingest (optional — only when running downloaders) ──
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# COMPCARS_GDRIVE_FILE_ID=
# COMPCARS_LOCAL_ROOT=/tmp/compcars
# HF_INGEST_MAX_ROWS=1000

# ── Glue / Lambda (deployed environments) ──
# INGEST_QUEUE_URL=
# ENRICHMENT_VERSION=0
# CLAIMLENS_SAMPLE_KEY=claims/sample.jpg
