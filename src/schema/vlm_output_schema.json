{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimLens VLM Output",
  "type": "object",
  "required": [
    "damage_class",
    "severity",
    "confidence",
    "damage_zones",
    "repair_estimate_usd",
    "total_loss_risk",
    "etl_tags",
    "pipeline_action"
  ],
  "properties": {
    "damage_class": {"type": "string"},
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "MAJOR", "MODERATE", "MINOR", "COSMETIC"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "damage_zones": {"type": "array", "items": {"type": "string"}},
    "repair_estimate_usd": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "integer"},
        "high": {"type": "integer"}
      }
    },
    "total_loss_risk": {"type": "boolean"},
    "etl_tags": {"type": "array", "items": {"type": "string"}},
    "pipeline_action": {
      "type": "string",
      "enum": [
        "AUTO_APPROVE",
        "QUEUE_FOR_REPAIR",
        "FLAG_REVIEW",
        "ROUTE_TO_ADJUSTER"
      ]
    }
  },
  "additionalProperties": true
}
